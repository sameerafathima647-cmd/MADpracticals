<?xml version="1.0" encoding="utf-8"?>
<!-- <set> allows us to group multiple animations to run at the same time -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:fillAfter="true"> <!-- fillAfter keeps the view in its final animated state -->

    <!-- Rotate 360 degrees from the center -->
    <rotate
        android:fromDegrees="0"
        android:toDegrees="360"

        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="1000" /> <!-- Duration in milliseconds (1 second) -->

    <!-- Scale the size from 1x to 2x from the center -->
    <scale
        android:fromXScale="1.0"
        android:toXScale="2.0"
        android:fromYScale="1.0"
        android:toYScale="2.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="1000" />
</set>
